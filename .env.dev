MODE=dev

# app
DB_DSN=postgres://postgres:postgres@db:5432/db?sslmode=disable
PORT=8000
JWT_SECRET=dev-jwt-secret
CLIENT_URL=http://localhost:8081
WEB_URL=http://localhost:8082
SERVER_URL=http://localhost:8000

# OAuth
GOOGLE_CLIENT_SECRET=dev-google-client-secret
GOOGLE_CLIENT_ID=dev-google-client-id
CLIENT_CALLBACK_URL=http://localhost:8000/auth/google/callback

# redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_TLS=false

# mailer
BREVO_API_KEY=dev-brevo-api-key
SMTP_FROM=dev@example.com

# S3 / R2
R2_ACCESS_KEY_ID=dev-r2-access-key
R2_SECRET_ACCESS_KEY=dev-r2-secret-key
R2_S3_BUCKET=dev-bucket
R2_ACCOUNT_ID=dev-r2-account-id
R2_PUBLIC_URL=https://example.r2.dev

# Home Assistant token encryption (32 chars)
HA_ENCRYPTION_KEY=12345678901234567890123456789012

# Gemini
GEMINI_API_KEY=dev-gemini-api-key

# basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# Web Push
VAPID_PUBLIC_KEY=dev_vapid_public_key
VAPID_PRIVATE_KEY=dev_vapid_private_key
VAPID_SUBJECT=mailto:dev@example.com
