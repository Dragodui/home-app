MODE=dev
# configs
# postgres (default) or sqlite; for sqlite, DB_DSN is a file path like ./data/home.db
DB_DRIVER=postgres
DB_DSN=postgres://postgres:postgres@localhost:5432/db
PORT=8000
JWT_SECRET=JWT_SECRET
CLIENT_URL=http://localhost:8081
WEB_URL=http://localhost:8082
SERVER_URL=http://localhost:8000

# OAuth
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
CLIENT_CALLBACK_URL=http://localhost:8000/auth/google/callback

# redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=REDIS_PASS
REDIS_TLS=true

# mailer (Brevo HTTP API - works on Render, no SMTP port blocking)
BREVO_API_KEY=your-brevo-api-key
SMTP_FROM=your-verified-sender@example.com

# Image storage: r2 (Cloudflare R2, default) or s7a (self-hosted, https://github.com/Dragodui/s7a)
STORAGE_PROVIDER=r2

# s7a (when STORAGE_PROVIDER=s7a). Run with docker-compose.s7a.yaml.
# In s7a .env set PUBLIC_URL to the same value as S7A_PUBLIC_URL and TRUST_PROXY=true.
S7A_URL=http://s7a:6465
S7A_API_KEY=same-as-API_KEY-in-s7a
# base of file links for clients; backend proxies /p/* and /public/* to s7a. Default: SERVER_URL
# S7A_PUBLIC_URL=https://api.example.com
# S7A_PUBLIC_BUCKET=home-public     # avatars, permanent links
# S7A_PRIVATE_BUCKET=home-private   # receipts, chat, shopping photos, expiring links

# S3 Configuration (when STORAGE_PROVIDER=r2)
R2_ACCESS_KEY_ID=r2_access_key
R2_SECRET_ACCESS_KEY=r2_secret_access_key
R2_S3_BUCKET=my-app

R2_ACCOUNT_ID=r2_account_id
R2_PUBLIC_URL=https://pub-<id>.r2.dev

# Home Assistant token encryption (exactly 32 characters for AES-256)
HA_ENCRYPTION_KEY=your-32-char-encryption-key-here!

# Gemini API (free tier: https://ai.google.dev/)
GEMINI_API_KEY=your-gemini-api-key

# basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# VAPID keys for Web Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourdomain.com